# ----- API server -----
API_PORT=4000
API_HOST=0.0.0.0
# Public origin allowed to call the API (the Next.js web app)
CORS_ORIGIN=http://localhost:3000

# ----- Storage -----
# Where uploads / converted files live. Auto-deleted after RETENTION_HOURS.
STORAGE_DIR=./storage
RETENTION_HOURS=24
# How often the cleanup sweeper runs (minutes)
CLEANUP_INTERVAL_MINUTES=30

# ----- Limits / security -----
MAX_FILE_SIZE_MB=500
# Sliding-window rate limit per IP
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=60
# Max conversions processed concurrently by the worker pool
MAX_CONCURRENT_JOBS=2

# ----- Conversion engines -----
# Absolute path or command name on PATH. Leave blank to auto-detect.
# FBX2glTF: https://github.com/godotengine/FBX2glTF/releases  (or facebookincubator)
FBX2GLTF_PATH=
# Blender 3.x/4.x used headless for GLB -> FBX
BLENDER_PATH=

# ----- Virus scanning (optional) -----
# If CLAMAV_ENABLED=true the API will scan uploads via clamdscan / clamscan.
CLAMAV_ENABLED=false
CLAMDSCAN_PATH=

# ----- Frontend (apps/web) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
